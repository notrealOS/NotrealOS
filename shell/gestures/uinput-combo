#!/usr/bin/env python3
"""Press a key combo through a short-lived uinput keyboard (real evdev codes, unlike
wtype's custom keymap, so SDL apps like Moonlight see the right keys).
Usage: uinput-combo CODE [CODE...]   e.g. 29 56 42 16 = Ctrl Alt Shift Q"""
import fcntl, os, struct, sys, time

UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
EV_SYN, EV_KEY = 0, 1
codes = [int(c) for c in sys.argv[1:]]

fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
for c in codes:
    fcntl.ioctl(fd, UI_SET_KEYBIT, c)
# legacy struct uinput_user_dev: name[80], input_id (4 x u16), ff_effects_max, abs arrays
os.write(fd, struct.pack("80sHHHHi", b"gestures-combo", 3, 1, 1, 1, 0) + b"\0" * (4 * 64 * 4))
fcntl.ioctl(fd, UI_DEV_CREATE)
time.sleep(0.4)  # let the compositor pick up the new keyboard

def ev(t, c, v):
    os.write(fd, struct.pack("llHHi", 0, 0, t, c, v))

for c in codes:
    ev(EV_KEY, c, 1); ev(EV_SYN, 0, 0); time.sleep(0.03)
time.sleep(0.05)
for c in reversed(codes):
    ev(EV_KEY, c, 0); ev(EV_SYN, 0, 0); time.sleep(0.03)
time.sleep(0.2)
fcntl.ioctl(fd, UI_DEV_DESTROY)
os.close(fd)
