#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
# Autostart wrapper for voiced.py; restarts it if it exits.
# gtk4-layer-shell must be loaded before libwayland-client (thinking overlay)
export LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so.0${LD_PRELOAD:+:$LD_PRELOAD}"
log="${XDG_RUNTIME_DIR:-/tmp}/voiced.log"
while :; do
	python3 $HERE/voiced.py >>"$log" 2>&1
	sleep 3
done
